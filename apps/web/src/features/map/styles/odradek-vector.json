{
  "version": 8,
  "name": "KEPLER Odradek Vector",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "protomaps": {
      "type": "vector",
      "url": "pmtiles:///api/utils/pmtiles/venezuela.pmtiles",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0a0f14"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#0d1218"
      }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": [
        "any",
        [
          "==",
          "pmap:kind",
          "park"
        ],
        [
          "==",
          "pmap:kind",
          "forest"
        ],
        [
          "==",
          "pmap:kind",
          "nature_reserve"
        ]
      ],
      "paint": {
        "fill-color": "#0a1a12",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "paint": {
        "fill-color": "#0a1520"
      }
    },
    {
      "id": "water-outline",
      "type": "line",
      "source": "protomaps",
      "source-layer": "water",
      "paint": {
        "line-color": "#00f7ff",
        "line-width": 0.5,
        "line-opacity": 0.3
      }
    },
    {
      "id": "rivers",
      "type": "line",
      "source": "protomaps",
      "source-layer": "physical_line",
      "filter": [
        "any",
        [
          "==",
          "pmap:kind",
          "river"
        ],
        [
          "==",
          "pmap:kind",
          "stream"
        ],
        [
          "==",
          "pmap:kind",
          "canal"
        ]
      ],
      "paint": {
        "line-color": "#00a8cc",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.5,
          10,
          1.5,
          14,
          3
        ],
        "line-opacity": 0.7
      }
    },
    {
      "id": "rivers-glow",
      "type": "line",
      "source": "protomaps",
      "source-layer": "physical_line",
      "filter": [
        "==",
        "pmap:kind",
        "river"
      ],
      "minzoom": 8,
      "paint": {
        "line-color": "#00f7ff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          3,
          14,
          8
        ],
        "line-blur": 3,
        "line-opacity": 0.15
      }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": [
        "any",
        [
          "==",
          "pmap:kind",
          "minor_road"
        ],
        [
          "==",
          "pmap:kind",
          "other"
        ],
        [
          "==",
          "pmap:kind",
          "path"
        ]
      ],
      "paint": {
        "line-color": "#1a2535",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.5,
          18,
          3
        ],
        "line-opacity": 0.6
      }
    },
    {
      "id": "roads-medium",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": [
        "==",
        "pmap:kind",
        "medium_road"
      ],
      "paint": {
        "line-color": "#2a3a4a",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1,
          18,
          6
        ]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": [
        "==",
        "pmap:kind",
        "major_road"
      ],
      "paint": {
        "line-color": "#3a5a7a",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          1,
          18,
          8
        ]
      }
    },
    {
      "id": "roads-highway-glow",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": [
        "==",
        "pmap:kind",
        "highway"
      ],
      "paint": {
        "line-color": "#00f7ff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          4,
          18,
          24
        ],
        "line-blur": 4,
        "line-opacity": 0.25
      }
    },
    {
      "id": "roads-highway",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": [
        "==",
        "pmap:kind",
        "highway"
      ],
      "paint": {
        "line-color": "#00f7ff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          1,
          18,
          10
        ],
        "line-opacity": 0.9
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-color": "#1a2535",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "buildings-outline",
      "type": "line",
      "source": "protomaps",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": {
        "line-color": "#00f7ff",
        "line-width": 0.3,
        "line-opacity": 0.4
      }
    },
    {
      "id": "road-labels-highway",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": [
        "all",
        [
          "==",
          "pmap:kind",
          "highway"
        ],
        [
          "has",
          "name"
        ]
      ],
      "minzoom": 10,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#00f7ff",
        "text-halo-color": "#0a0f14",
        "text-halo-width": 2
      }
    },
    {
      "id": "road-labels-major",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": [
        "all",
        [
          "==",
          "pmap:kind",
          "major_road"
        ],
        [
          "has",
          "name"
        ]
      ],
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#6688aa",
        "text-halo-color": "#0a0f14",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "road-labels-medium",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": [
        "all",
        [
          "==",
          "pmap:kind",
          "medium_road"
        ],
        [
          "has",
          "name"
        ]
      ],
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 9
      },
      "paint": {
        "text-color": "#5577aa",
        "text-halo-color": "#0a0f14",
        "text-halo-width": 1
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "physical_point",
      "filter": [
        "any",
        [
          "==",
          "pmap:kind",
          "lake"
        ],
        [
          "==",
          "pmap:kind",
          "ocean"
        ],
        [
          "==",
          "pmap:kind",
          "sea"
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12,
        "text-letter-spacing": 0.15
      },
      "paint": {
        "text-color": "#00a8cc",
        "text-halo-color": "#0a0f14",
        "text-halo-width": 1
      }
    },
    {
      "id": "places-city",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "filter": [
        "any",
        [
          "==",
          "pmap:kind",
          "city"
        ],
        [
          "==",
          "pmap:kind",
          "town"
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          10,
          14,
          18
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#00f7ff",
        "text-halo-color": "#0a0f14",
        "text-halo-width": 2,
        "text-opacity": 0.9
      }
    },
    {
      "id": "places-village",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "filter": [
        "==",
        "pmap:kind",
        "village"
      ],
      "minzoom": 10,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#5599aa",
        "text-halo-color": "#0a0f14",
        "text-halo-width": 1
      }
    },
    {
      "id": "places-neighborhood",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "filter": [
        "==",
        "pmap:kind",
        "neighbourhood"
      ],
      "minzoom": 14,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#446688",
        "text-halo-color": "#0a0f14",
        "text-halo-width": 1
      }
    }
  ]
}