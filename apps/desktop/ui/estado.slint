// Estado que Rust rellena (src/ui.rs) y las pantallas leen.
import { DatoIndicador } from "componentes.slint";

export { DatoIndicador }

// Factor de la Preparación (sueño, pulso en reposo…) con lo que suma o resta
export struct FactorPrep {
    texto: string,
    puntos: string,
    negativo: bool,
}

export struct Atencion {
    cantidad: int,
    resaltado: string,
    texto: string,
    icono: string,
}

export struct Conteo {
    valor: int,
    etiqueta: string,
    color: color,
}

export struct FilaMision {
    id: string,
    codigo: string,
    titulo: string,
    estado: string,
    fecha: string,
}

export struct DiaSemana {
    etiqueta: string,
    km: float,
}

export struct Notificacion {
    id: string,
    // critical · warning · success · info
    tipo: string,
    mensaje: string,
    fecha: string,
    leida: bool,
}

export struct Hallazgo {
    id: string,
    nombre: string,
    etiqueta: string,
    tono: color,
    fecha: string,
    imagen: image,
    tiene-imagen: bool,
}

export struct MisionArchivo {
    // "" = todas · "ninguna" = sin misión · uuid
    id: string,
    titulo: string,
    detalle: string,
    estado: string,
}

// Copia editable de un hallazgo (los campos que no aplican al tipo se ignoran)
export struct Detalle {
    id: string,
    // objetos · personas · puntos_interes
    tipo: string,
    nombre: string,
    // descripción (objetos, POIs) o rasgos físicos (personas)
    texto: string,
    // notas (personas)
    notas: string,
    // hostilidad (personas) o nivel de riesgo (POIs)
    nivel: string,
    // estado del POI: activo · verificado · inactivo
    estado: string,
    compartido: bool,
    categoria: int,
    subcategoria: int,
    datos: string,
    imagen: image,
    tiene-imagen: bool,
}

export struct Candidato {
    id: string,
    nombre: string,
    similitud: float,
    fecha: string,
    imagen: image,
    tiene-imagen: bool,
}

export struct SeleccionMapa {
    visible: bool,
    tipo: string,
    nombre: string,
    detalle: string,
    tono: color,
    fecha: string,
    imagen: image,
    tiene-imagen: bool,
}

export struct UnidadVivo {
    id: string,
    nombre: string,
    detalle: string,
    activa: bool,
}

// Caja de detección normalizada a [0, 1] respecto al fotograma
export struct CajaVivo {
    x: float,
    y: float,
    ancho: float,
    alto: float,
    etiqueta: string,
    tono: color,
}

export struct FilaObjeto {
    id: string,
    nombre: string,
    categoria: string,
    total: int,
    tono: color,
}

export struct EtiquetaRadar {
    texto: string,
    // Posición normalizada [0, 1] dentro del gráfico
    x: float,
    y: float,
}

export struct CategoriaPoi {
    id: string,
    nombre: string,
    tono: color,
    propios: int,
    compartidos: int,
}

export struct FilaRuta {
    nombre: string,
    detalle: string,
    seguridad: string,
    tono: color,
}

// Línea de Markdown simplificado: 0 párrafo · 1 título · 2 viñeta
export struct LineaMd {
    texto: string,
    tipo: int,
}

// Foto de un hallazgo que Cortex muestra en su respuesta
export struct FotoChat {
    id: string,
    // objetos · personas · puntos_interes
    tipo: string,
    nombre: string,
    imagen: image,
    tiene-imagen: bool,
}

export struct MensajeChat {
    // user · assistant
    rol: string,
    lineas: [LineaMd],
    fotos: [FotoChat],
}

export struct ChatFila {
    id: string,
    titulo: string,
    fecha: string,
}

export struct EtiquetaSel {
    id: string,
    nombre: string,
    tono: color,
    objetos: int,
    activa: bool,
}

export struct CategoriaTax {
    nombre: string,
    tono: color,
    objetos: int,
    subcategorias: string,
}

export struct FilaSistema {
    nombre: string,
    detalle: string,
    // 0 bien · 1 aviso · 2 fallo
    estado: int,
}

export enum Pantalla { login, dashboard, envivo, mapa, archivos, cortex, bitacora }

export global Estado {
    in-out property <Pantalla> pantalla: Pantalla.login;
    in property <string> servidor;

    // Login
    in-out property <bool> entrando;
    in-out property <string> error-login;

    // Sesión
    in property <string> usuario;
    in property <string> nombre-visible;
    in property <string> iniciales;
    in property <string> rol;
    in property <bool> en-linea;
    in property <string> enlace;
    in property <bool> en-vivo;
    in property <string> version;

    // Notificaciones (las 20 últimas para el panel) y toasts
    in property <int> no-leidas;
    in property <[Notificacion]> notificaciones;
    in property <[Notificacion]> toasts;

    // Bitácora completa
    in property <[Notificacion]> bitacora;
    in-out property <string> bitacora-tipo;
    in-out property <bool> bitacora-solo-no-leidas;
    in property <bool> bitacora-cargando;
    in property <bool> bitacora-hay-mas;

    // Dashboard
    in property <bool> cargando;
    in property <string> error;
    in property <string> actualizado;
    in property <[DatoIndicador]> indicadores;
    in property <[Atencion]> atenciones;
    in property <[FilaMision]> misiones;
    in property <[Conteo]> conteos;
    in property <float> calzado: 1;
    in property <float> resistencia: 1;
    in property <string> clima;
    in property <bool> es-dia: true;
    in property <string> ubicacion;
    in property <[DiaSemana]> semana;
    in property <string> semana-total;
    in property <string> semana-linea;
    in property <float> semana-max: 1;
    in property <string> consejo;
    // Preparación del explorador (F8): puntuación 0-100, nivel alta/media/baja
    in property <bool> prep-hay;
    in property <int> prep-puntuacion;
    in property <string> prep-nivel;
    in property <string> prep-resumen;
    in property <[FactorPrep]> prep-factores;
    in property <string> prep-sueno;
    in property <string> prep-reposo;
    in property <string> prep-estres;
    in property <string> prep-pasos;
    in property <string> prep-base;
    in property <string> prep-ultima;
    in property <[FilaObjeto]> objetos-frecuentes;
    in property <string> radar-poligono;
    in property <string> radar-rejilla;
    in property <string> radar-ejes;
    in property <[EtiquetaRadar]> radar-etiquetas;
    in property <[CategoriaPoi]> poi-categorias;
    in-out property <string> poi-categoria;
    in property <string> poi-categoria-nombre;
    in property <[Hallazgo]> poi-lista;
    in property <bool> poi-cargando;
    in property <[Hallazgo]> personas-recientes;
    in property <[FilaRuta]> rutas-recientes;
    callback abrir-categoria-poi(string, string);
    callback abrir-hallazgo(string, string);
    callback ver-todo(string);

    callback entrar(string, string);
    callback salir();
    // Archivos
    in-out property <string> archivos-tipo: "objetos";
    in-out property <string> archivos-mision;
    in-out property <string> archivos-busqueda;
    in property <[MisionArchivo]> archivos-misiones;
    in property <[Hallazgo]> archivos;
    in property <bool> archivos-cargando;
    in property <bool> archivos-hay-mas;
    in property <[string]> categorias;
    in property <[string]> subcategorias;
    in-out property <bool> detalle-abierto;
    in property <Detalle> detalle;
    in property <bool> detalle-guardando;
    in property <string> detalle-error;
    callback cargar-archivos();
    callback mas-archivos();
    callback abrir-detalle(string);
    callback elegir-categoria(int);
    callback guardar-detalle(Detalle);
    callback eliminar-detalle(string);

    // Comparador de identidades
    in property <int> pendientes-identidad;
    in-out property <bool> comparador-abierto;
    in property <[Candidato]> comparador-personas;
    in property <[Candidato]> comparador-candidatos;
    in-out property <int> comparador-persona;
    in-out property <int> comparador-candidato;
    in property <bool> comparador-cargando;
    callback abrir-comparador();
    callback elegir-persona(int);
    callback vincular(string, string);

    // Mapa
    in property <image> mapa-imagen;
    in property <bool> mapa-listo;
    // Descarga del mapa offline o error ("" = nada que decir)
    in property <string> mapa-aviso;
    in property <float> mapa-progreso: -1;
    in property <float> mapa-zoom;
    in-out property <bool> capa-pois: true;
    in-out property <bool> capa-personas: true;
    in-out property <bool> capa-objetos: true;
    in-out property <bool> capa-alertas: true;
    in-out property <bool> capa-rutas: true;
    // Planificador de rutas
    in property <bool> plan-activo;
    in property <int> plan-puntos;
    in property <string> plan-km;
    in property <string> plan-riesgo;
    in property <color> plan-tono;
    in property <[FilaRuta]> plan-hallazgos;
    in property <bool> plan-analizando;
    in property <string> plan-mensaje;
    callback plan-alternar();
    callback plan-deshacer();
    callback plan-limpiar();
    callback plan-analizar();
    callback plan-guardar(string);
    in property <SeleccionMapa> mapa-seleccion;
    in property <[string]> mapa-misiones;
    in-out property <int> mapa-mision;
    in property <string> mapa-rastro-info;
    callback mapa-tamano(length, length);
    callback mapa-mover(length, length);
    callback mapa-rueda(float, length, length);
    callback mapa-clic(length, length);
    callback mapa-capas();
    callback mapa-elegir-mision(int);
    callback mapa-centrar();
    callback mapa-cerrar-seleccion();

    // En vivo (Unidades de Campo)
    in property <[UnidadVivo]> vivo-unidades;
    in property <int> vivo-activas;
    in property <bool> vivo-elegida-activa;
    in-out property <string> vivo-seleccion;
    in property <image> vivo-imagen;
    in property <bool> vivo-hay-imagen;
    in property <float> vivo-aspecto: 1.333;
    in property <[CajaVivo]> vivo-cajas;
    in property <string> vivo-pie;
    in property <float> vivo-bateria: -1;
    in property <[DatoIndicador]> vivo-datos;
    in property <string> vivo-coordenadas;
    in property <string> vivo-mision;
    callback vivo-elegir(string);
    callback vivo-ver-en-mapa();

    // Cortex
    in property <[ChatFila]> cortex-chats;
    in-out property <string> cortex-chat;
    in property <[MensajeChat]> cortex-mensajes;
    in property <string> cortex-estado;
    in property <bool> cortex-escribiendo;
    in property <string> cortex-avatar: "🤖";
    in property <string> cortex-error;
    callback cortex-enviar(string);
    callback cortex-abrir(string);
    callback cortex-nuevo();
    callback cortex-borrar(string);

    // Ventana de IA: reporte de novedades o Deep-Dive
    in-out property <bool> ia-abierta;
    in property <string> ia-titulo;
    in property <[LineaMd]> ia-lineas;
    in property <string> ia-estado;
    in property <bool> ia-cargando;
    in property <bool> ia-regenerable;
    callback ia-reporte(bool);
    callback ia-analizar(string);

    // Perfil
    in-out property <bool> perfil-abierto;
    in property <string> perfil-nombre;
    in property <string> perfil-bio;
    in property <string> perfil-ubicacion;
    in property <string> perfil-avatar-ia: "🤖";
    in property <string> perfil-datos;
    in property <string> perfil-mensaje;
    in property <bool> perfil-ocupado;
    in property <image> foto;
    in property <bool> tiene-foto;
    callback perfil-abrir();
    callback perfil-guardar(string, string, string, string);
    callback perfil-foto();
    callback perfil-calzado();
    callback perfil-contrasena(string, string);

    // Taxonomía y etiquetas
    in-out property <bool> tax-abierta;
    in property <[CategoriaTax]> tax-categorias;
    in property <[EtiquetaSel]> etiquetas;
    in property <string> tax-mensaje;
    callback tax-abrir();
    callback etiqueta-crear(string, string);
    callback etiqueta-borrar(string);
    // Etiquetas del objeto abierto en el detalle
    in property <[EtiquetaSel]> detalle-etiquetas;
    callback detalle-etiqueta(string);

    // Estado del sistema
    in-out property <bool> sis-abierto;
    in property <[FilaSistema]> sis-filas;
    in property <bool> sis-cargando;
    callback sis-abrir();

    // Misiones
    in-out property <bool> mision-abierta;
    in property <string> mision-id;
    in property <string> mision-titulo;
    in property <string> mision-codigo;
    in property <string> mision-estado;
    in property <string> mision-datos;
    in property <string> mision-hallazgos;
    in property <[LineaMd]> mision-reporte;
    in property <bool> mision-ocupada;
    in property <string> mision-mensaje;
    in-out property <bool> nueva-mision-abierta;
    callback abrir-mision(string);
    callback mision-accion(string);
    callback crear-mision(string, string, string, string, string);

    callback refrescar();
    callback ir(Pantalla);
    callback marcar-leida(string);
    callback marcar-todas();
    // Vuelve a cargar con bitacora-tipo y bitacora-solo-no-leidas
    callback filtrar-bitacora();
    callback mas-bitacora();
    callback cerrar-toast(string);
}
