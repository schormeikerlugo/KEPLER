// Ventana del Centro de Control.
import "../../../design/fonts/Jura-Variable.ttf";
import { Tema } from "tema.slint";
import { Estado, Pantalla } from "estado.slint";
import { PantallaLogin } from "login.slint";
import { Cabecera } from "cabecera.slint";
import { PantallaDashboard } from "dashboard.slint";
import { PanelNotificaciones, Toasts, PantallaBitacora } from "notificaciones.slint";
import { Acerca } from "acerca.slint";
import { PantallaArchivos, ModalDetalle, Comparador } from "archivos.slint";
import { PantallaMapa } from "mapa.slint";
import { PantallaVivo } from "vivo.slint";
import { PantallaCortex, VentanaIA } from "cortex.slint";
import { VentanaPerfil, VentanaTaxonomia, VentanaSistema } from "perfil.slint";
import { VentanaMision, VentanaNuevaMision } from "misiones.slint";

export { Estado, Pantalla }

export component AppWindow inherits Window {
    title: "KEPLER · Centro de Control";
    icon: @image-url("img/icono.svg");
    preferred-width: 1600px;
    preferred-height: 1000px;
    min-width: 1280px;
    min-height: 760px;
    background: Tema.fondo;
    default-font-family: "Jura";

    property <bool> panel-abierto;
    property <bool> acerca-abierto;

    if Estado.pantalla == Pantalla.login: PantallaLogin {
        cargando: Estado.entrando;
        error: Estado.error-login;
        servidor: Estado.servidor;
        entrar(u, c) => { Estado.entrar(u, c); }
    }

    if Estado.pantalla != Pantalla.login: VerticalLayout {
        padding-top: 30px;
        padding-bottom: 30px;
        padding-left: Tema.espacio-pagina;
        padding-right: Tema.espacio-pagina;
        spacing: 22px;

        Cabecera {
            panel-abierto: root.panel-abierto;
            campana => { root.panel-abierto = !root.panel-abierto; }
            acerca => { root.acerca-abierto = true; }
        }

        if Estado.error != "": Rectangle {
            height: 40px;
            border-radius: Tema.radio-medio;
            background: #FF444418;
            border-width: 1px;
            border-color: #FF444455;
            Text { text: "⚠  " + Estado.error; color: Tema.peligro; font-size: 13px; }
        }

        if Estado.pantalla == Pantalla.dashboard: PantallaDashboard { vertical-stretch: 1; }
        if Estado.pantalla == Pantalla.bitacora: PantallaBitacora { vertical-stretch: 1; }
        if Estado.pantalla == Pantalla.archivos: PantallaArchivos { vertical-stretch: 1; }
        if Estado.pantalla == Pantalla.mapa: PantallaMapa { vertical-stretch: 1; }
        if Estado.pantalla == Pantalla.envivo: PantallaVivo { vertical-stretch: 1; }
        if Estado.pantalla == Pantalla.cortex: PantallaCortex { vertical-stretch: 1; }
    }

    // Panel de la campana: un clic fuera lo cierra
    if root.panel-abierto && Estado.pantalla != Pantalla.login: TouchArea {
        clicked => { root.panel-abierto = false; }
        PanelNotificaciones {
            x: root.width - self.width - Tema.espacio-pagina - 150px;
            y: 30px + 103px + 8px;
            ver-bitacora => {
                root.panel-abierto = false;
                Estado.ir(Pantalla.bitacora);
            }
        }
    }

    if Estado.pantalla != Pantalla.login: Toasts {
        x: root.width - 380px - 28px;
        y: root.height - self.preferred-height - 28px;
        width: 380px;
        height: self.preferred-height;
    }

    if Estado.detalle-abierto && Estado.pantalla != Pantalla.login: Rectangle {
        background: #000000b3;
        TouchArea { }
        ModalDetalle {
            cerrar => { Estado.detalle-abierto = false; }
        }
    }

    if Estado.comparador-abierto && Estado.pantalla == Pantalla.archivos: Rectangle {
        background: #000000b3;
        TouchArea { }
        Comparador {
            cerrar => { Estado.comparador-abierto = false; }
        }
    }

    if Estado.ia-abierta && Estado.pantalla != Pantalla.login: Rectangle {
        background: #000000b3;
        TouchArea { clicked => { Estado.ia-abierta = false; } }
        VentanaIA { cerrar => { Estado.ia-abierta = false; } }
    }

    if Estado.perfil-abierto && Estado.pantalla != Pantalla.login: Rectangle {
        background: #000000b3;
        TouchArea { }
        VentanaPerfil { cerrar => { Estado.perfil-abierto = false; } }
    }

    if Estado.tax-abierta && Estado.pantalla != Pantalla.login: Rectangle {
        background: #000000b3;
        TouchArea { clicked => { Estado.tax-abierta = false; } }
        VentanaTaxonomia { cerrar => { Estado.tax-abierta = false; } }
    }

    if Estado.sis-abierto && Estado.pantalla != Pantalla.login: Rectangle {
        background: #000000b3;
        TouchArea { clicked => { Estado.sis-abierto = false; } }
        VentanaSistema { cerrar => { Estado.sis-abierto = false; } }
    }

    if Estado.mision-abierta && Estado.pantalla != Pantalla.login: Rectangle {
        background: #000000b3;
        TouchArea { clicked => { Estado.mision-abierta = false; } }
        VentanaMision { cerrar => { Estado.mision-abierta = false; } }
    }

    if Estado.nueva-mision-abierta && Estado.pantalla != Pantalla.login: Rectangle {
        background: #000000b3;
        TouchArea { }
        VentanaNuevaMision { cerrar => { Estado.nueva-mision-abierta = false; } }
    }

    if root.acerca-abierto: Rectangle {
        background: #000000b3;
        TouchArea {
            clicked => { root.acerca-abierto = false; }
        }
        Acerca {
            cerrar => { root.acerca-abierto = false; }
        }
    }
}
