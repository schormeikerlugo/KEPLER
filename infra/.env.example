# KEPLER — variables del stack (cortex)
# No editar a mano los secretos: genera el .env con  scripts/gen-env.sh

############ Secretos ############
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
PG_META_CRYPTO_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# Acceso a Studio (http://<host>:54321/)
DASHBOARD_USERNAME=kepler
DASHBOARD_PASSWORD=

############ URLs ############
# Dirección con la que los clientes llegan al gateway
SUPABASE_PUBLIC_URL=http://192.168.68.117:54321
API_EXTERNAL_URL=http://192.168.68.117:54321/auth/v1
SITE_URL=http://192.168.68.117:54321
ADDITIONAL_REDIRECT_URLS=

############ Auth ############
JWT_EXPIRY=3600
SMTP_ADMIN_EMAIL=admin@kepler.local

############ kepler-server ############
KEPLER_SERVER_PORT=8000
# Ollama en orden de preferencia: PC (RTX 3060) → Mac mini
KEPLER_OLLAMA_URLS=http://192.168.68.114:11434,http://192.168.68.120:11434
KEPLER_OLLAMA_MODELO=mistral:7b
# Orígenes web permitidos (vacío: ninguno; las apps nativas no usan CORS)
KEPLER_CORS_ORIGENES=

############ Rutas y puertos (cortex) ############
KEPLER_API_PORT=54321
KEPLER_DB_PORT=54322
KEPLER_DB_DATA=./volumes/db/data
KEPLER_STORAGE_DIR=/mnt/storage/kepler/storage
KEPLER_BACKUP_DIR=/mnt/storage/kepler/backups
KEPLER_MAPAS_DIR=/mnt/storage/kepler/mapas
KEPLER_MODELOS_DIR=/mnt/storage/kepler/modelos
KEPLER_VISION_HILOS=4
KEPLER_BACKUP_HOUR=3
KEPLER_BACKUP_RETENTION_DAYS=14
TZ=America/Caracas
