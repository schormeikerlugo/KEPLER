{
    "name": "kepler-monorepo",
    "version": "0.5.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:web": "npm run dev -w @kepler/web",
        "dev:desktop": "npm run dev -w @kepler/desktop",
        "dev:mobile": "npm run start -w @kepler/mobile",
        "build:shared": "npm run build -w @kepler/shared",
        "build:web": "npm run build -w @kepler/web",
        "build:desktop": "npm run build -w @kepler/desktop",
        "build:all": "npm run build:shared && npm run build:web && npm run build:desktop",
        "rebuild:shared": "npm run rebuild -w @kepler/shared",
        "start:backend": "cd backend && source .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:logs": "docker-compose logs -f"
    },
    "devDependencies": {
        "typescript": "^5.3.0"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}